<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="20dp"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Meu Cadastro / Currículo"
            android:textColor="#1976D2"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editNomeCandidato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Nome Completo"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/editTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Telefone / WhatsApp"
            android:inputType="phone" />


        <EditText
            android:id="@+id/editEndereco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Endereço (Ex: Centro, Matinhos - PR)"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/editPretensao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pretensão Salarial (Ex: R$ 2.500,00)"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/editExperiencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Experiência Profissional e Resumo..."
            android:inputType="textMultiLine"
            android:lines="4"
            android:gravity="top|start"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSalvarCadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#1976D2"
            android:text="Salvar"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnExcluirCurriculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Excluir Meu Currículo"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>