<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/txtNomeCandidato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nome do Candidato"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/txtEmailCandidato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="E-mail"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/txtEnderecoCandidato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Endereço"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/txtPretensaoCandidato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pretensão Salarial"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:text="Experiência Profissional / Resumo:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/txtExperienciaCandidato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Detalhes da experiência..."
        android:textSize="15sp"
        android:textColor="#333333"/>

</LinearLayout>